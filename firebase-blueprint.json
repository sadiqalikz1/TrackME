{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Firebase Auth" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "INR"], "description": "Preferred currency" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner's user ID" },
        "amount": { "type": "number", "description": "Transaction amount" },
        "type": { "type": "string", "enum": ["income", "expense"], "description": "Transaction type" },
        "category": { "type": "string", "description": "Category name or ID" },
        "date": { "type": "string", "format": "date-time", "description": "Transaction date" },
        "note": { "type": "string", "description": "Optional note" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Record creation timestamp" }
      },
      "required": ["uid", "amount", "type", "category", "date"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly budget limit for a category",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner's user ID" },
        "category": { "type": "string", "description": "Category name" },
        "limit": { "type": "number", "description": "Monthly limit amount" },
        "month": { "type": "string", "description": "Month in YYYY-MM format" }
      },
      "required": ["uid", "category", "limit", "month"]
    },
    "Work": {
      "title": "Work",
      "description": "A professional project or job tracking",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner's user ID" },
        "title": { "type": "string", "description": "Work title" },
        "description": { "type": "string", "description": "Work details" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed", "cancelled"], "description": "Current status" },
        "quotationAmount": { "type": "number", "description": "Estimated amount" },
        "finalAmount": { "type": "number", "description": "Actual amount received" },
        "workingCost": { "type": "number", "description": "Internal cost" },
        "expenses": { "type": "number", "description": "Additional expenses" },
        "profit": { "type": "number", "description": "Calculated profit" },
        "photos": { "type": "array", "items": { "type": "string" }, "description": "List of photo URLs" },
        "progress": { "type": "number", "description": "Progress percentage (0-100)" },
        "isProfitTransferred": { "type": "boolean", "description": "Whether profit was moved to personal account" },
        "startDate": { "type": "string", "format": "date-time", "description": "Start date" },
        "endDate": { "type": "string", "format": "date-time", "description": "End date" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "title", "status", "quotationAmount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transaction records"
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "User budget settings"
    },
    "/works/{workId}": {
      "schema": "Work",
      "description": "Professional work tracking records"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own data
    // All collections follow the pattern: uid field must match auth.uid
    
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }
    
    match /transactions/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
    
    match /budgets/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
    
    match /work/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
    
    match /goals/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
    
    match /billReminders/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
    
    match /recurringTransactions/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
    
    match /quotations/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
    
    match /timeEntries/{document=**} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || !("uid" in resource.data));
      allow write: if request.auth != null && (request.resource.data.uid == request.auth.uid || !("uid" in resource.data));
    }
  }
}

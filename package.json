{
  "name": "financeflow",
  "version": "1.0.0",
  "description": "A comprehensive personal finance tracking app for Android with work project management, budgeting, and real-time analytics.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "lint": "tsc --noEmit",
    "clean": "expo start -c"
  },
  "keywords": [
    "finance",
    "budget",
    "expense-tracker",
    "react-native",
    "expo",
    "android",
    "firebase"
  ],
  "author": "SADIQ",
  "license": "MIT",
  "dependencies": {

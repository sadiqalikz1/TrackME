    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "firebase"
        ]
      }
    },
    "sdkVersionCheckConfig": {
      "exclude": [
        "@react-navigation/bottom-tabs",
        "@react-navigation/native",
        "@react-navigation/native-stack"
      ]
    }
